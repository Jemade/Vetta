# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
RATE_LIMIT_PER_MINUTE=60

# Database
# For SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./vetta.db
# For PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+asyncpg://vetta:vetta@localhost:5432/vetta

# Celery & Cache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM / AI Evaluation
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=vetta-interview-artifacts
# Optional endpoint for LocalStack or MinIO (e.g. http://localhost:4566):
AWS_S3_ENDPOINT_URL=
# Local storage fallback directory when S3 credentials are unset:
LOCAL_STORAGE_DIR=./storage_uploads
